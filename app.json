{
  "expo": {
    "name": "buy-again",
    "slug": "buy-again",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buy-again",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.naokiwebdev.buyagain",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.naokiwebdev.buyagain",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "buy-againがバーコードを読み取るためにカメラを使います。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "buy-againが商品写真を登録するために写真へアクセスします。",
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["ja", "en"],
            "android": ["ja", "en"]
          }
        }
      ]
    ],
    "locales": {
      "ja": "./locales/ja.json",
      "en": "./locales/en.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
